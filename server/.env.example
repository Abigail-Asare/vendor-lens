# ============================================================
# VendorLens Backend Environment Configuration
# ============================================================
# Duplicate this file as '.env' and fill in your actual values.
# IMPORTANT: NEVER commit '.env' or your Firebase service key to Git!

# Server port and runtime environment
PORT=5000
NODE_ENV=development

# Allowed origins for CORS (comma-separated if multiple)
# In development, the Vite frontend typically runs on port 5173
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK Configuration
# Option 1: Path to serviceAccountKey.json file (relative to server directory or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# Option 2 (Recommended for Render/production deployment):
# Provide credentials directly via individual env vars or single-line JSON string
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...-----END PRIVATE KEY-----\n"

# Business Timezone default for analytics (Africa/Accra)
BUSINESS_TIMEZONE=Africa/Accra
