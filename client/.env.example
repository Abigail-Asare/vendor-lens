# ============================================================
# VendorLens Frontend Client Environment Configuration
# ============================================================
# Duplicate this file as '.env' in the client/ directory.

# Base API URL:
# In local development with Vite proxy, leave empty or set to '/api'
# In production (e.g. on Vercel), set to your deployed Render backend URL:
# Example: https://vendorlens-api.onrender.com/api
VITE_API_URL=/api

# Firebase Web Client Configuration (Will be used in Milestone 3)
# Obtain these from your Firebase Console -> Project Settings -> General -> Your Apps
VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
